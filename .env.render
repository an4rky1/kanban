# ============================================================
# RENDER ENVIRONMENT VARIABLES
# 1. Сгенерируй APP_KEY локально: php artisan key:generate --show
# 2. Вставь APP_KEY и Internal Connection String в DB_URL ниже.
# 3. Скопируй всё содержимое этого файла (кроме комментариев)
#    и вставь в Render Dashboard → Environment → Import from .env
# ============================================================

APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=errorlog

# Сгенерируй командой: php artisan key:generate --show
APP_KEY=base64:hDH9RRvZ2ulHs0qfQ3GaLLG32vgZx1Bgk6qwKM6rGcY=

# Internal Connection String из панели Render (PostgreSQL)
DB_CONNECTION=pgsql
DB_URL=postgresql://kanban_db_1os5_user:FdCXOuerilqM0U3x2J7v2x9GRTuN6X4z@dpg-d87fcjojs32c73ad6m2g-a/kanban_db_1os5
DB_SSLMODE=require

# Storage & Sessions
FILESYSTEM_DISK=public
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue
CACHE_STORE=database
QUEUE_CONNECTION=database

# Broadcast (отключено для Render)
BROADCAST_CONNECTION=null
